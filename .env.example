# Every "change-me"-style value below is a PUBLIC placeholder: generate your own (see INSTALLATION.md).
# With DJANGO_DEBUG=false the backend refuses to start while any core secret is a placeholder.
# Lost or leaked a secret? docs/SECURITY_INCIDENT_RESPONSE.md
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=sqlite:///db.sqlite3
# Shared cache is required for lockout/throttling with several workers, e.g. redis://localhost:6379/0
# CACHE_URL=locmemcache://marosimgo

# JWT — a different secret from DJANGO_SECRET_KEY
JWT_SIGNING_KEY=change-me-too
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7

# PINFL (JSHSHIR) protection
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# Comma separated: the FIRST key encrypts, all keys decrypt (key rotation).
PINFL_ENCRYPTION_KEYS=generate-a-fernet-key
PINFL_HASH_KEY=another-long-random-secret

# Ceremony ownership & invitations (the same keys above encrypt invitation phone / JSHSHIR)
# OWNER access always needs an OTP-verified phone; keep true outside throwaway test databases.
CEREMONY_OWNER_REQUIRE_VERIFIED_PHONE=true
CEREMONY_INVITATION_TTL_DAYS=14
CEREMONY_MAX_PENDING_INVITATIONS=50
CEREMONY_MAX_INVITATION_SENDS=5

# Web security
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Behind the Next.js proxy (or nginx) set the number of trusted proxies
NUM_PROXIES=1
# Build absolute URLs with the panel host forwarded by the Next.js proxy
USE_X_FORWARDED_HOST=true
# Serve /media/ from Django (dev / small installs). Use nginx in production.
SERVE_MEDIA=true
AUTH_COOKIE_SECURE=true
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
USE_X_FORWARDED_PROTO=false

# Rate limits
THROTTLE_LOGIN=5/min
THROTTLE_PINFL_REVEAL=20/hour
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
THROTTLE_REGISTER=10/hour

# Phone login (E.164). Comma separated ISO regions; the first one is the default.
PHONE_ALLOWED_REGIONS=UZ
# Optional anti-bot verifier for /auth/register/: dotted path to guard(request) -> bool
BOT_PROTECTION_GUARD=

# API monitoring (request metrics; no bodies, headers or tokens are stored)
MONITORING_ENABLED=true
MONITORING_ASYNC=true
MONITORING_RETENTION_DAYS=14
MONITORING_MAX_ROWS=2000000
# Base URL shown in the generated cURL / fetch / Python examples
PUBLIC_API_BASE_URL=http://localhost:8000

# Google Drive storage (Phase A) — see docs/GOOGLE_DRIVE_SETUP.md
# Fernet key for encrypting the Google refresh token (REQUIRED to connect Drive):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
GOOGLE_TOKEN_ENCRYPTION_KEY=
# OAuth client: by default read from backend/credentials/google_oauth_client.json (git-ignored).
# Set these two only to override the file (e.g. production secret manager):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/admin/storage/google/callback/
# Optional initial root folder (Phase B picks it in the panel)
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Where the OAuth callback returns the browser (the Super Admin panel)
PANEL_URL=http://localhost:3000
THROTTLE_STORAGE_CONNECT=20/hour

# AI Fashion Studio — live virtual try-on (Decart lucy-vton) — see docs/AI_FASHION_STUDIO.md
# Permanent server-side key from https://platform.decart.ai (API keys). NEVER put it in a frontend .env.
# Empty = the AI studio is shown as "not enabled" (no fake fallback).
DECART_API_KEY=
DECART_API_BASE=https://api.decart.ai
DECART_TRYON_MODEL=lucy-vton-latest
# Browser client-token lifetime (1-3600 s); only needed to open/reconnect a WebRTC session
DECART_TOKEN_TTL_SECONDS=60
# Origins allowed to use client tokens (comma separated; empty = not restricted)
DECART_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
DECART_REQUEST_TIMEOUT_SECONDS=10
# Primary Virtual Try-On (fal.ai: FASHN v1.6 photo + Kling O3 video-to-video edit)
FAL_KEY=
FAL_TRYON_PHOTO_MODEL=fal-ai/fashn/tryon/v1.6
FAL_TRYON_VIDEO_MODEL=fal-ai/kling-video/o3/standard/video-to-video/edit
FAL_TRYON_TIMEOUT_SECONDS=240
# Cost controls (Decart bills per generated second)
AI_TRYON_MAX_SESSION_SECONDS=180
AI_TRYON_DAILY_SECONDS_PER_USER=900
AI_TRYON_DAILY_SESSIONS_PER_USER=10
AI_TRYON_GLOBAL_DAILY_SECONDS=0
AI_TRYON_MAX_TOKENS_PER_SESSION=20
AI_TRYON_PRICE_PER_SECOND_USD=0.02
AI_TRYON_MAX_SAVED_LOOKS=50
THROTTLE_AI_TRYON_SESSION=20/hour
THROTTLE_AI_TRYON_TOKEN=60/hour
THROTTLE_TRYON_LOOK=60/hour
# Saved looks are stored here (owner-only downloads, never under /media/)
PRIVATE_MEDIA_ROOT=

# ---------------------------------------- AI event planner (Claude, Anthropic API)
# Server-side key from https://console.anthropic.com — NEVER put it in a frontend .env, never in the DB.
# Empty = the AI chat shows "temporarily unavailable"; plans, the budget calculator and bookings keep working.
ANTHROPIC_API_KEY=
# Per attempt; the SDK retries connection errors, 408/409/429 and 5xx (worst case ≈ timeout × (retries+1))
AI_PLANNER_TIMEOUT_SECONDS=45
AI_PLANNER_MAX_RETRIES=2
# Anthropic server-side refusal fallback (beta server-side-fallback-2026-07-01)
AI_PLANNER_REFUSAL_FALLBACK=true
THROTTLE_AI_PLANNER_MESSAGE=30/min
THROTTLE_AI_PLANNER_WRITE=600/hour
THROTTLE_AI_PLANNER_ADMIN_WRITE=120/hour
# Model, effort, daily/monthly limits, feature flags and maintenance mode are set by the Super Admin
# in the panel (AI maslahatchi → Sozlamalar), not here.

# --------------------------------------------------------- frontend/.env.local
# Where the Next.js server proxies /api/v1 and /media (server-side only)
BACKEND_URL=http://127.0.0.1:8000
